{
  "_note": "PRODUCTION config for the full 204-country byProduct NTL export. Run: npm run batch -- --config config/config.production-ntl.json  (see docs/FRIEND_SETUP_GUIDE.md). byProduct + Detail=NTL + source=direct (Mirror is disabled for byProduct). Full list = countries-full.xlsx (204). Randomized anti-block throttle (break after a random 1-5 countries for a random 2-7 min). NTL tables are heavy: dataReadyTimeoutMs=15min, download timeoutMs=10min. Own resume manifest so it never clashes with a byPartner run; re-running the SAME command resumes where it left off.",
  "tradeMapBaseUrl": "https://www.trademap.org",
  "outputDirectory": "./output",
  "browserProfileDir": "./browser-profile",
  "logsDir": "./logs",
  "countryCodesFile": "./config/country-codes.json",

  "filters": {
    "tradeFlow": "imports",
    "exporter": "world",
    "exporterCode": "000",
    "product": "ALL",
    "viewBy": "product",
    "frequency": "monthly",
    "source": "direct",
    "dataType": "values",
    "currency": "USD",
    "view": "table",
    "detail": "NTL"
  },

  "auth": {
    "maxLoginAttempts": 3
  },

  "datePolicy": {
    "requestedStart": "200001",
    "requestedEnd": "202606",
    "mode": "MAX_WITHIN_REQUESTED_RANGE"
  },

  "download": {
    "format": "xlsx",
    "overwrite": false,
    "collisionMode": "skip",
    "timeoutMs": 600000,
    "downloadAttempts": 2,
    "dataReadyTimeoutMs": 900000
  },

  "batch": {
    "inputFile": "./input/countries-full.xlsx",
    "maxAttemptsPerCountry": 3,
    "retryDelayMs": 2000,
    "continueOnFailure": true,
    "evidenceDir": "./screenshots/failures",
    "throttleEveryMin": 1,
    "throttleEveryMax": 5,
    "throttlePauseMinMs": 120000,
    "throttlePauseMaxMs": 420000
  },

  "manifestFile": "./manifests/latest-run-ntl.json",
  "runReportFile": "./manifests/run-report-ntl.xlsx",

  "filenameTemplate": "{countrySlug}__{flow}-from-World__{detailWord}__{startPretty}_to_{endPretty}__{frequency}-{source}-{currency}.{extension}"
}
